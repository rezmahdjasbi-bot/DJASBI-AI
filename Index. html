>

<button onclick="lirePhoto()">
Analyser mon exercice
</button>
<p id="reponse"></p>
</div> 
<script>
function repondre() {
    let q = document.getElementById("question").value.trim();
    let r = document.getElementById("reponse");

    if (q === "") {
        r.innerText = "Pose-moi une question !";
        return;
    }

    let m = q.match(/^\s*(-?\d+(?:[.,]\d+)?)\s*([+\-*\/])\s*(-?\d+(?:[.,]\d+)?)\s*=?\s*\??\s*$/);

    if (!m) {
        r.innerText = "Je ne sais pas encore répondre à cette question.";
        return;
    }

    let a = Number(m[1].replace(",", "."));
    let b = Number(m[3].replace(",", "."));
    let op = m[2];
    let resultat;

    switch (op) {
        case "+":
            resultat = a + b;
            break;
        case "-":
            resultat = a - b;
            break;
        case "*":
            resultat = a * b;
            break;
        case "/":
            resultat = b === 0 ? "Impossible" : a / b;
            break;
    }

    r.innerText = "DJASBI AI : La réponse est " + resultat;
}
</script>

</body>
